# Copy to .env and fill in. Any OpenAI-compatible provider works.
#
# --- OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# --- or Anthropic (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-4-5
# LLM_API_KEY=sk-ant-...

# --- or OpenRouter / Groq / Together ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_API_KEY=sk-or-...

# The judge should ideally be a DIFFERENT model from the generator, so the judge
# is not grading its own writing style. See report section on judge bias.
JUDGE_MODEL=gpt-4o
